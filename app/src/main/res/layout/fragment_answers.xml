<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:textAlignment="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/btnMercury"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/purple_500"
            android:text="@string/planet_mercury"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnVenus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/purple_500"
            android:text="@string/planet_venus"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnEarth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/purple_500"
            android:text="@string/planet_earth"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnMars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/purple_500"
            android:text="@string/planet_mars"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnJupiter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/purple_500"
            android:text="@string/planet_jupiter"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnSaturn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/purple_500"
            android:text="@string/planet_saturn"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnUranus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/purple_500"
            android:text="@string/planet_uranus"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnNeptune"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/purple_500"
            android:text="@string/planet_neptune"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
